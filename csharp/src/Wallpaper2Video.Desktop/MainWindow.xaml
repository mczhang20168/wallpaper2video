<Window x:Class="Wallpaper2Video.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Wallpaper2Video.Desktop"
        Title="Wallpaper2Video" Icon="Assets/Logo.ico" Width="1460" Height="900" MinWidth="1040" MinHeight="650" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" Background="#17191E" Foreground="#E7EAF0" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <Style x:Key="PanelTab" TargetType="RadioButton"><Setter Property="Foreground" Value="#AAB4C3"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="4,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tab" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#E7EAF0"/><Setter TargetName="Tab" Property="BorderBrush" Value="#8DA9FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#303B4B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <ContextMenu x:Key="SourcePanelActions" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}"><MenuItem Header="显示所选原素材" Command="{Binding ShowSelectedSourcesCommand}"/><MenuItem Header="隐藏所选原素材" Command="{Binding HideSelectedSourcesCommand}"/><Separator/><MenuItem Header="撤销显隐更改" Command="{Binding UndoEffectsCommand}" InputGestureText="Ctrl+Z"/></ContextMenu>
    <local:BrowserRowWidthConverter x:Key="BrowserRowWidth"/>
    <ContextMenu x:Key="EffectPanelActions" x:Shared="False" Background="#272D37" Foreground="#E7EAF0" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
      <MenuItem Header="显示所选" Command="{Binding EnableSelectedCommand}"/>
      <MenuItem Header="隐藏所选" Command="{Binding DisableSelectedCommand}"/>
      <MenuItem Header="切换所选显隐" Command="{Binding ToggleVisibilityCommand}" InputGestureText="Space"/>
      <Separator/>
      <MenuItem Header="选择组内项目" Command="{Binding SelectContextGroupCommand}" Visibility="{Binding HasBrowserGroupContext,Converter={StaticResource BoolVisibility}}"/>
      <MenuItem Header="显示组内项目" Command="{Binding ShowContextGroupCommand}" Visibility="{Binding HasBrowserGroupContext,Converter={StaticResource BoolVisibility}}"/>
      <MenuItem Header="隐藏组内项目" Command="{Binding HideContextGroupCommand}" Visibility="{Binding HasBrowserGroupContext,Converter={StaticResource BoolVisibility}}"/>
      <MenuItem Header="选择全部匹配项" Command="{Binding SelectAllEffectsCommand}" InputGestureText="Ctrl+A"/>
      <MenuItem Header="取消选择" Command="{Binding ClearEffectSelectionCommand}" InputGestureText="Esc"/>
      <Separator/>
      <MenuItem Header="展开全部" Command="{Binding ExpandGroupsCommand}" InputGestureText="Ctrl+Num +"/>
      <MenuItem Header="折叠全部" Command="{Binding CollapseGroupsCommand}" InputGestureText="Ctrl+Num −"/>
      <Separator/>
      <MenuItem Header="撤销显隐更改" Command="{Binding UndoEffectsCommand}" InputGestureText="Ctrl+Z"/>
    </ContextMenu>
    <Style TargetType="local:EffectCheckBox">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="34"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="True"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:EffectCheckBox"><Grid Background="Transparent">
        <Border x:Name="Hover" CornerRadius="3" Background="Transparent" Margin="2,3"/>
        <Canvas x:Name="Eye" Width="20" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35">
          <Path Data="M1,8 C5,1 15,1 19,8 C15,15 5,15 1,8 Z" Stroke="#CAD5E5" StrokeThickness="1.4"/>
          <Ellipse Width="6" Height="6" Canvas.Left="7" Canvas.Top="5" Fill="#CAD5E5"/>
          <Path x:Name="Slash" Data="M2,1 L18,15" Stroke="#A4B0C1" StrokeThickness="1.5"/>
        </Canvas>
        <Path x:Name="Lock" Data="M5,8 L5,5 C5,0 15,0 15,5 L15,8 M3,8 L17,8 17,17 3,17 Z" Width="15" Height="17" Stretch="Uniform" Stroke="#939FAF" StrokeThickness="1.3" Visibility="Collapsed"/>
      </Grid><ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Eye" Property="Opacity" Value="1"/><Setter TargetName="Slash" Property="Visibility" Value="Collapsed"/></Trigger>
        <DataTrigger Binding="{Binding Ineffective}" Value="True"><Setter TargetName="Eye" Property="Opacity" Value="0.45"/></DataTrigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="#46536A"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="Background" Value="#46536A"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Eye" Property="Visibility" Value="Collapsed"/><Setter TargetName="Lock" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:PlayerTimeline">
      <Setter Property="Height" Value="36"/><Setter Property="Cursor" Value="Hand"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:PlayerTimeline"><Grid Background="Transparent" Margin="10,0"><Border Height="6" Background="#495263" CornerRadius="3"/>
        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
          <Track.DecreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" Background="#8DA9FF" CornerRadius="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="16" Height="26"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#CFDAFF" CornerRadius="5" BorderBrush="#8DA9FF" BorderThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" Background="#495263" CornerRadius="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
      </Grid><ControlTemplate.Triggers><Trigger Property="Maximum" Value="0"><Setter TargetName="PART_Track" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BrowserContainer" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Body" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#2A3240"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Body" Property="Background" Value="#314D78"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
    <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding FolderCommand}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ExportCommand}"/>
  </Window.InputBindings>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件"><MenuItem Header="打开项目或视频…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/><MenuItem Header="打开文件夹…" Command="{Binding FolderCommand}"/><Separator/>
        <MenuItem Header="设置输出文件…" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/><MenuItem Header="打开输出视频" Command="{Binding OpenOutputCommand}"/><MenuItem Header="打开输出文件夹" Command="{Binding OpenOutputFolderCommand}"/></MenuItem>
      <MenuItem Header="导出视频" Command="{Binding ExportCommand}"/>
    </Menu>
    <Border DockPanel.Dock="Top" Padding="18,12"><DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消任务" Command="{Binding CancelCommand}" Margin="0,0,8,0"/><Button Content="导出 MP4 ↗" Background="{StaticResource Accent}" Foreground="#172033" Command="{Binding ExportCommand}"/></StackPanel>
      <Image Source="Assets/Logo.png" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,20,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel></Border>
    <StackPanel DockPanel.Dock="Bottom" Margin="14,8"><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" MaxHeight="54"/>
      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding RecordingProgressText}" Margin="0,0,0,4"/><ProgressBar Height="14" Value="{Binding RecordingProgress,Mode=OneWay}" Maximum="100" Foreground="#FF6A70" Background="#343943" BorderThickness="0" IsEnabled="{Binding RecordingApplicable}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{Binding ExportProgressText}" Margin="0,0,0,4"/><ProgressBar Height="14" Value="{Binding ExportProgress,Mode=OneWay}" Maximum="100" Foreground="{StaticResource Accent}" Background="#343943" BorderThickness="0"/></StackPanel>
      </Grid>
    </StackPanel>
    <Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="290" MinWidth="240"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="6"/><ColumnDefinition Width="370" MinWidth="320"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#22252C"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="15" IsEnabled="{Binding CanEdit}">
        <TextBlock Text="项目与输出" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="素材文件" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding SourcePath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="素材路径"/>
        <UniformGrid Columns="2" Margin="0,8,0,6"><Button Content="打开素材" Command="{Binding OpenCommand}" ToolTip="选择 project.json、scene.json、scene.pkg 或已有视频；壁纸目录也可用右侧按钮打开。" Margin="0,0,4,0"/><Button Content="打开文件夹" Command="{Binding FolderCommand}" Margin="4,0,0,0"/></UniformGrid>
        <Button Content="载入 / 刷新素材" Command="{Binding LoadCommand}"/>
        <TextBlock Text="{Binding ProjectInfo}" Foreground="{StaticResource Muted}" Margin="0,12,0,22"/>
        <TextBlock Text="视频参数" Style="{StaticResource SectionTitle}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,12"><TextBlock Text="总长 · 秒" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DurationText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="总长秒"/></StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="帧率 · fps" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding FpsText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="帧率"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="宽度 · px" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding WidthText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="输出宽度"/></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="高度 · px" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding HeightText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="输出高度"/></StackPanel>
          <StackPanel Grid.Row="2"><TextBlock Text="循环交叠 · 秒" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding OverlapText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="交叠秒"/></StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="画质 · CRF" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CrfText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="画质CRF"/></StackPanel>
        </Grid>
        <TextBlock Text="{Binding ValidationText}" Foreground="{StaticResource Accent}" Margin="0,12,0,24"/>
        <TextBlock Text="{Binding RecommendationText}" Foreground="{StaticResource Muted}" FontSize="12"/>
        <Button Content="采用推荐总长" Command="{Binding ApplyRecommendationCommand}" Margin="0,8,0,12"/>
        <StackPanel Visibility="{Binding HasEntrance,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
          <CheckBox Content="保留入场 · 普通视频" IsChecked="{Binding PreserveEntrance}"/>
          <TextBlock Text="默认跳过已识别入场。保留后输出普通视频，整段重复播放会重播入场。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>
        <TextBlock Text="输出文件" Style="{StaticResource SectionTitle}"/>
        <TextBox Text="{Binding OutputPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="输出路径"/>
        <Button Content="设置保存位置…" Command="{Binding SaveCommand}" Margin="0,8,0,8"/>
        <UniformGrid Columns="2"><Button Content="打开视频" Command="{Binding OpenOutputCommand}" Margin="0,0,4,0"/><Button Content="输出文件夹" Command="{Binding OpenOutputFolderCommand}" Margin="4,0,0,0"/></UniformGrid>
        <Expander Header="高级设置" Foreground="{StaticResource Ink}" Margin="0,24,0,12"><StackPanel Margin="0,12,0,0">
          <TextBlock Text="FFmpeg 路径（留空自动查找）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding FfmpegPath,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Wallpaper Engine 目录或 exe" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><TextBox Text="{Binding EnginePath,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="录制启动准备" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
          <CheckBox Content="自动等待引擎首帧就绪" IsChecked="{Binding AutomaticStartupWait}" Foreground="{StaticResource Ink}"/>
          <StackPanel Visibility="{Binding CustomStartupWait,Converter={StaticResource BoolVisibility}}"><TextBlock Text="录制前启动等待 · 秒" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><TextBox Text="{Binding WarmupText,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <TextBlock Text="仅场景录制使用。历史模拟效果可取消自动并增加等待；启动等待不保证循环闭合。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
          <CheckBox Content="录制画面在工作区显示" IsChecked="{Binding EmbeddedRecording}" Foreground="{StaticResource Ink}" Margin="0,12,0,0"/>
        </StackPanel></Expander>
      </StackPanel></ScrollViewer></Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#17191E"/>
      <Border Grid.Column="2" Background="#22252C"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10"><TextBlock Text="{Binding ViewerInfo}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="节目监视器" FontWeight="SemiBold" FontSize="16"/></DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="{Binding CanEdit}"><TextBlock Text="预览清晰度" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label" Width="160" AutomationProperties.Name="预览清晰度"/></StackPanel>
        <Grid Grid.Row="2" Background="#0C0E12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border x:Name="RecordingBadge" Background="#552329" Padding="10,6" Visibility="{Binding IsRecording,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="录制中标记"><TextBlock Text="● REC · 录制中" Foreground="#FF7E84" FontWeight="Bold" HorizontalAlignment="Left"/></Border>
        <Grid x:Name="CaptureSurface" Grid.Row="1" Background="#0C0E12" ClipToBounds="True">
          <TextBlock Text="W / V" Foreground="#3A414D" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed" MediaEnded="OnMediaEnded"/>
          <Image x:Name="DecodedFrames" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Image x:Name="Poster" Source="{Binding PosterSource}" Stretch="Uniform" IsHitTestVisible="False">
            <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Image.Style>
          </Image>
          <Border Background="#D917191E" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="10,6" Margin="8"><TextBlock Text="{Binding PreviewNotice}" Foreground="#E9B778" FontSize="12"/></Border>
        </Grid></Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,5"><DockPanel><Button Content="{Binding PreviewActionText}" Command="{Binding PreviewCommand}" DockPanel.Dock="Right"/><StackPanel Orientation="Horizontal"><Button Content="{Binding PlayText}" Command="{Binding PlayCommand}"/><Button Content="‹" Click="OnPreviousFrame" ToolTip="前一帧" Padding="10,6" Margin="4,0,0,0"/><Button Content="›" Click="OnNextFrame" ToolTip="后一帧" Padding="10,6"/></StackPanel></DockPanel>
          <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" FontSize="13" Margin="0,7,0,0" TextWrapping="NoWrap"/>
        </StackPanel>
        <local:PlayerTimeline Grid.Row="4" Minimum="0" Maximum="{Binding MediaDuration,Mode=OneWay}" Value="{Binding Position,Mode=TwoWay}" SmallChange="{Binding FrameStep}" LargeChange="1" Thumb.DragStarted="OnSeekStarted" Thumb.DragCompleted="OnSeekCompleted" Margin="0,0,0,8" IsEnabled="{Binding CanSeek}" AutomationProperties.Name="播放进度"/>
        <Border Grid.Row="5" Background="#1B1E24" Padding="12"><StackPanel><TextBlock Text="时间参考" FontWeight="SemiBold"/><TextBlock Text="{Binding ValidationText}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
          <local:ParticleTimeline Height="52" Duration="{Binding VideoDuration}" Start="{Binding ParticleStart}" Stop="{Binding ParticleStop}" Visibility="{Binding CanSetParticleWindow,Converter={StaticResource BoolVisibility}}"/>
          <TextBlock Text="交叠用于平滑循环接缝，预览完整成片后再导出。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
      </Grid></Border>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#17191E"/>
      <Border Grid.Column="4" Background="#22252C"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="110"/><RowDefinition Height="6"/><RowDefinition Height="2*" MinHeight="230"/></Grid.RowDefinitions>
        <StackPanel IsEnabled="{Binding CanEdit}">
          <DockPanel Margin="0,0,0,8">
            <Button Content="⋯" DockPanel.Dock="Right" Width="32" Height="32" Padding="2" FontSize="20" Click="OnEffectPanelMenu" ContextMenu="{StaticResource EffectPanelActions}" ToolTip="面板菜单：选择、显隐、展开与撤销" AutomationProperties.Name="效果面板菜单" Visibility="{Binding ShowingEffects,Converter={StaticResource BoolVisibility}}"/>
            <Button Content="⋯" DockPanel.Dock="Right" Width="32" Height="32" Padding="2" FontSize="20" Click="OnEffectPanelMenu" ContextMenu="{StaticResource SourcePanelActions}" ToolTip="原素材显隐与撤销" AutomationProperties.Name="原素材面板菜单" Visibility="{Binding ShowingSources,Converter={StaticResource BoolVisibility}}"/>
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding BrowserGroupings}" SelectedItem="{Binding BrowserGrouping}" Width="90" Margin="0,0,6,0" AutomationProperties.Name="效果分组方式" Visibility="{Binding ShowingEffects,Converter={StaticResource BoolVisibility}}"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><RadioButton Content="效果与粒子" GroupName="RightPanel" Style="{StaticResource PanelTab}" IsChecked="{Binding ShowingEffects,Mode=OneWay}" Command="{Binding ShowEffectsPanelCommand}"/><RadioButton Content="原素材" GroupName="RightPanel" Style="{StaticResource PanelTab}" IsChecked="{Binding ShowingSources,Mode=OneWay}" Command="{Binding ShowSourcesCommand}" Margin="6,0,0,0"/></StackPanel>
          </DockPanel>
          <Grid Margin="0,0,0,7" Visibility="{Binding ShowingEffects,Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索名称、类型或对象路径" AutomationProperties.Name="效果搜索"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding EffectStateFilters}" SelectedItem="{Binding EffectStateFilter}" AutomationProperties.Name="效果状态筛选"/>
          </Grid>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#3B4351" BorderThickness="0,0,0,1" Padding="0,2,0,6" Visibility="{Binding ShowingEffects,Converter={StaticResource BoolVisibility}}"><DockPanel>
          <TextBlock Text="{Binding BrowserCountText}" FontSize="12" Foreground="{StaticResource Muted}" DockPanel.Dock="Right"/>
          <TextBlock Text="显隐    名称 / 对象层级" FontSize="12" Foreground="{StaticResource Muted}"/>
        </DockPanel></Border>
        <local:EffectBrowserList Grid.Row="2" Visibility="{Binding ShowingEffects,Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding BrowserRows}" SelectionMode="Extended" ItemContainerStyle="{StaticResource BrowserContainer}" IsEnabled="{Binding CanEdit}" Background="#22252C" Foreground="{StaticResource Ink}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" ContextMenu="{StaticResource EffectPanelActions}" AutomationProperties.Name="效果列表">
          <ListBox.ItemTemplate><DataTemplate><Grid Height="40" ToolTip="{Binding Hint}">
            <Grid.Width><MultiBinding Converter="{StaticResource BrowserRowWidth}"><Binding Path="ViewportWidth" RelativeSource="{RelativeSource AncestorType={x:Type ScrollViewer}}"/><Binding Path="MinimumWidth"/></MultiBinding></Grid.Width>
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <local:EffectCheckBox DataContext="{Binding Effect}" IsChecked="{Binding Active,Mode=OneWay}" IsEnabled="{Binding CanToggle}" ToolTip="{Binding Hint}" Visibility="{Binding DataContext.IsLeaf,RelativeSource={RelativeSource AncestorType=Grid},Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Caption}"/>
            <Grid Grid.Column="1">
              <local:HierarchyGuides Depth="{Binding Depth}" Mask="{Binding GuideMask}" Last="{Binding LastSibling}" IsHitTestVisible="False"/>
              <Grid Margin="{Binding Indent}"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <Button Content="{Binding Arrow}" Click="OnBrowserExpand" Padding="0" Background="Transparent" Visibility="{Binding HasChildren,Converter={StaticResource BoolVisibility}}" FontSize="14" ToolTip="展开 / 折叠；Alt+点击递归操作" AutomationProperties.Name="展开对象"/>
                <local:BrowserNodeIcon Grid.Column="1" Kind="{Binding Icon}" Width="18" Height="20" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E2E7EE"/><Setter Property="FontSize" Value="14"/><Style.Triggers><DataTrigger Binding="{Binding HasChildren}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding Effect.CanToggle}" Value="False"><Setter Property="Foreground" Value="#9AA6B7"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <TextBlock Grid.Column="3" Text="{Binding Summary}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,4,0"/>
              </Grid>
            </Grid>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </local:EffectBrowserList>
        <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding ShowingSources,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanEdit}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <TextBox Text="{Binding SourceSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索原始对象名称、类型或来源文件" AutomationProperties.Name="原素材搜索"/>
          <TextBlock Grid.Row="1" Text="{Binding SourceCountText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,7"/>
          <ListBox x:Name="SourceLayerList" Grid.Row="2" ItemsSource="{Binding SourceRows}" SelectionMode="Extended" SelectionChanged="OnSourceSelectionChanged" ItemContainerStyle="{StaticResource BrowserContainer}" Background="#22252C" Foreground="#E7EAF0" BorderThickness="0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ContextMenu="{StaticResource SourcePanelActions}" PreviewKeyDown="OnSourceKeyDown" AutomationProperties.Name="原素材列表">
            <ListBox.ItemTemplate><DataTemplate><Grid Height="40" ToolTip="{Binding Hint}"><Grid.Width><MultiBinding Converter="{StaticResource BrowserRowWidth}"><Binding Path="ViewportWidth" RelativeSource="{RelativeSource AncestorType={x:Type ScrollViewer}}"/><Binding Path="MinimumWidth"/></MultiBinding></Grid.Width><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <local:EffectCheckBox IsChecked="{Binding Active,Mode=OneWay}" IsEnabled="{Binding CanToggle}" ToolTip="{Binding Hint}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Caption}"/>
              <Grid Grid.Column="1"><local:HierarchyGuides Depth="{Binding Depth}" Mask="{Binding GuideMask}" Last="{Binding LastSibling}" IsHitTestVisible="False"/><Grid Margin="{Binding Indent}"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Content="{Binding Arrow}" Click="OnSourceExpand" Padding="0" Background="Transparent" FontSize="14" Visibility="{Binding HasChildren,Converter={StaticResource BoolVisibility}}" ToolTip="展开 / 折叠原素材对象"/>
                <local:BrowserNodeIcon Grid.Column="1" Kind="{Binding Icon}" Width="18" Height="20" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="14"/>
              </Grid></Grid>
            </Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="#343943"/>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="OnSettingsWheel"><StackPanel Margin="0,8,0,0" IsEnabled="{Binding CanEdit}">
          <DockPanel Margin="0,0,0,10"><TextBlock Text="属性" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/></DockPanel>
          <ItemsControl ItemsSource="{Binding Phases}" Visibility="{Binding HasPhases,Converter={StaticResource BoolVisibility}}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,16">
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Origin}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,6"/>
            <DockPanel Margin="0,0,0,6"><Button Content="恢复自动" Command="{Binding ResetCommand}" DockPanel.Dock="Right" Padding="6,4" FontSize="12"/><TextBlock Text="{Binding ModeText}" Foreground="{StaticResource Accent}" FontSize="12" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="次数滑块 1–100 · 大数值可直接输入" Foreground="{StaticResource Muted}" FontSize="12"/>
            <Slider Minimum="1" Maximum="{Binding Maximum}" Value="{Binding SliderCycles,Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1"/>
            <DockPanel Margin="0,6,0,0"><TextBox Text="{Binding CycleText,UpdateSourceTrigger=PropertyChanged}" Width="75" Height="32" VerticalAlignment="Center" DockPanel.Dock="Right"/><TextBlock Text="{Binding PeriodText}" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/></DockPanel>
            <StackPanel Visibility="{Binding IsSkeletal,Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0"><TextBlock Text="目标速度倍率（保持原方向，自动对齐整数次数）" Foreground="{StaticResource Muted}" FontSize="12"/><TextBox Text="{Binding RateText,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="动画速度倍率"/></StackPanel>
          </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <StackPanel Visibility="{Binding HasSelectedParticle,Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding SelectedEffect.ShortName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,8"/>
            <TextBlock Text="播放方式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ParticleModeInput" ItemsSource="{Binding ParticleModes}" SelectedItem="{Binding SelectedParticleMode}" IsEnabled="{Binding SelectedEffect.CanToggle}" AutomationProperties.Name="粒子播放方式">
              <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="IsEnabled" Value="{Binding IsAvailable}"/><Setter Property="ToolTip" Value="{Binding Hint}"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers></Style></ComboBox.ItemContainerStyle>
            </ComboBox>
            <Grid Visibility="{Binding CanSetParticleWindow,Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="开始发射 · 秒" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ParticleStartInput" Text="{Binding ParticleStartText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="粒子开始生成秒数"/>
                <Slider Minimum="0" Maximum="{Binding VideoDuration}" Value="{Binding ParticleStart,Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="{Binding FrameStep}"/>
              </StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="停止发射 · 秒" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ParticleStopInput" Text="{Binding ParticleStopText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="粒子停止生成秒数"/>
                <Slider Minimum="0" Maximum="{Binding VideoDuration}" Value="{Binding ParticleStop,Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="{Binding FrameStep}"/>
              </StackPanel>
            </Grid>
            <StackPanel IsEnabled="{Binding CanSetParticlePrewarm}" Margin="0,12,0,0">
              <TextBlock Text="粒子预热时间 · 模拟秒" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="ParticlePrewarmInput" Text="{Binding ParticlePrewarmText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="粒子预热时间秒"/>
            </StackPanel>
            <TextBlock Text="留空：自然播放沿用原素材，定时从空场开始。输入0～120模拟秒独立预热，不计入成片总长；0秒从空场开始。飞入和渐显保留。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding ParticleWarning}" Foreground="#E9B778" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel>
          <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
          <Expander Header="全部时长来源核查" Foreground="{StaticResource Ink}" Margin="0,10,0,8"><TextBlock Text="{Binding TimingAuditText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></Expander>
        </StackPanel></ScrollViewer>
      </Grid></Border>
    </Grid>
  </DockPanel>
</Window>
